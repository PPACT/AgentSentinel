{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_git.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_paths.py\""
          },
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_fixtures.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/report_session_log.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
