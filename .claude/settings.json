{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_context.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_git.py\""
          },
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_deps.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_deps.py\""
          },
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_paths.py\""
          },
          {
            "type": "command",
            "command": "uv run python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_fixtures.py\""
          }
        ]
      }
    ]
  }
}
