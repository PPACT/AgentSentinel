# 复制为 .env 后填入真实值：copy .env.example .env
SENTINEL_WEBHOOK_SECRET=
SENTINEL_GIT_USER_NAME="AgentSentinel Bot"
SENTINEL_GIT_USER_EMAIL="bot@example.com"
SENTINEL_GIT_REMOTE_URL="https://github.com/your-org/target-repo.git"

# ===== 模型后端：stub=离线默认；real=调用 OpenAI 兼容端点 =====
SENTINEL_MODEL_BACKEND=stub

# ===== 优异模型（Coder / Tester）=====
# 任意 OpenAI Chat Completions 兼容端点：填 base_url + model + api_key
SENTINEL_PREMIUM_BASE_URL=
SENTINEL_PREMIUM_MODEL=
SENTINEL_PREMIUM_API_KEY=
SENTINEL_PREMIUM_TEMPERATURE=0.0
SENTINEL_PREMIUM_MAX_TOKENS=8192

# ===== 平价模型（Orchestrator / Writer）=====
SENTINEL_ECONOMY_BASE_URL=
SENTINEL_ECONOMY_MODEL=
SENTINEL_ECONOMY_API_KEY=
SENTINEL_ECONOMY_TEMPERATURE=0.2
SENTINEL_ECONOMY_MAX_TOKENS=4096

# ===== 用量与预算（P2-3c）=====
# 单价按“每百万 Token”填写，货币单位自定（全项目保持一致）
SENTINEL_BUDGET_LIMIT=0
SENTINEL_PREMIUM_INPUT_PRICE_PER_MTOK=0
SENTINEL_PREMIUM_OUTPUT_PRICE_PER_MTOK=0
SENTINEL_ECONOMY_INPUT_PRICE_PER_MTOK=0
SENTINEL_ECONOMY_OUTPUT_PRICE_PER_MTOK=0
