{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "C1 minimal permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:*" }]
    },
    {
      "identifier": "http:allow-fetch",
      "allow": [{ "url": "http://127.0.0.1:*" }]
    }
  ]
}
